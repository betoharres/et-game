; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ETs"
run/main_scene="uid://xvrcvkjy2juc"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=75
config/icon="res://icon.svg"

[autoload]

GlobalScore="*uid://cwlo1k62mtyku"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[dotnet]

project/assembly_name="Novo Projeto de Jogo"

[file_customization]

folder_colors={
"res://3dModelos/": "purple",
"res://Materiais/": "yellow",
"res://Texturas/": "teal",
"res://scenes/": "red",
"res://scripts/": "green"
}

[global_group]

characters="holds player characters"
vehicles="holds player driven vehicles"
pickup_items="pickables by the player"

