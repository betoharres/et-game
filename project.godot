; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ETs"
run/main_scene="uid://xvrcvkjy2juc"
config/features=PackedStringArray("4.8", "Forward Plus")
run/max_fps=75
config/icon="res://icon.svg"

[autoload]

GlobalScore="*uid://cwlo1k62mtyku"
PhotoAlertSystem="*res://scripts/photo_alert_system.gd"
SceneTransition="*res://scripts/scene_transition.gd"
GdPAIAutoload="*res://addons/GdPlanningAI/gdpai_autoload.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="viewport"
window/vsync/vsync_mode=2

[dotnet]

project/assembly_name="Novo Projeto de Jogo"

[editor_plugins]

enabled=PackedStringArray("res://addons/GdPlanningAI/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://3dModelos/": "purple",
"res://Materiais/": "yellow",
"res://Texturas/": "teal",
"res://assets/": "blue",
"res://scenes/": "red",
"res://scripts/": "green",
"res://shaders/": "pink",
"res://tools/": "orange"
}

[global_group]

characters="holds player characters"
vehicles="holds player driven vehicles"
pickup_items="pickables by the player"
concealment_areas="vegetation areas that reduce player visibility"
photographers="NPCs that can photograph the player"

