# ─────────────────────────────────────────────────────────────────────────────
# Godot — arquivos gerados pela engine. Estes SIM devem ser ignorados: são
# recriados automaticamente e são específicos de cada máquina.
# ─────────────────────────────────────────────────────────────────────────────
/.godot/
/.import/
/.mono/
/android/
/data_*/
/build/

# Credenciais e configuração de export
/export.cfg
/export_credentials.cfg

# Traduções geradas e relatórios de crash
*.translation
mono_crash.*.json

# Artefatos temporários de build de GDExtension (Windows)
addons/*/bin/~*
*~RF*.TMP

# Metadados do Unity que vieram nos pacotes Synty. O Godot nunca lê estes
# arquivos — ele usa .import. Sao 699 arquivos de peso morto.
*.meta

# Sistema operacional
.DS_Store

# ─────────────────────────────────────────────────────────────────────────────
# NÃO ADICIONE AQUI  —  leia antes de mexer
# ─────────────────────────────────────────────────────────────────────────────
#
# *.import  →  NÃO IGNORAR. Guarda as OPÇÕES de import de cada asset, não o
#   resultado. Em 3dModelos/ são 646 modelos com importer="ArrayMesh"; o padrão
#   do Godot para .fbx/.glb é importer="scene". Sem o .import versionado, quem
#   reimporta do zero recria tudo como PackedScene, as cenas pedem ArrayMesh,
#   a malha vira nula e os objetos ficam INVISÍVEIS (nave, props, veículos).
#   Custo de versionar: 832 KB em 3137 arquivos.
#
# *.uid  →  NÃO IGNORAR. É o identificador estável de cada recurso. Ignorado,
#   cada máquina gera UIDs próprios, o Godot grava esses UIDs dentro dos .tscn
#   ao salvar, e duas pessoas editando a mesma cena produzem diff em quase toda
#   linha ext_resource. Foi a causa de 19 das 20 linhas em conflito no merge
#   ca5306d de scenes/world.tscn — ruído puro, nenhuma mudança real.
#
# Texturas/  →  NÃO IGNORAR. São as texturas do jogo (101 MB). Ignorá-las fez
#   o git apagar 297 arquivos do disco de quem deu pull no merge ebe3291.
#
# Temporarios/  →  NÃO IGNORAR. 31 cenas referenciam assets daqui (228 MB).
#
# scenes/terrain3d_*.res  →  NÃO IGNORAR. É o terreno em si: o nó Terrain3D
#   em world.tscn tem data_directory = "res://scenes". São 1.3 MB e sem eles o
#   mundo carrega sem relevo.
#
# Regra geral: ignore o que a engine RECRIA sozinha (/.godot/), nunca o que ela
# LÊ para montar o projeto (.import, .uid, assets, dados de terreno).
